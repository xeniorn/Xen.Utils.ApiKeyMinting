<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--remove any preconfigured repos, use only what's defined here-->
	<clear/>
    <!--default nuget repo-->
	<add key="nuget" value="https://api.nuget.org/v3/index.json" />
	<!--our custom proteomics nuget repo-->
	<!--this MUST use underscore, NOT dash, otehrwise it can't be injected as env var on unix-->
    <add key="github_vbc_proteomics" value="https://nuget.pkg.github.com/vbc-proteomics-org/index.json" />
  </packageSources>
</configuration>