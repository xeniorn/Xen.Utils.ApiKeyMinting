<Project>

	<!--
	    Shared packaging setup for every packable project in this repository (template: xeniorn/ProcessTools).
	    Imported explicitly by each packable csproj, which keeps only PackageId, Description, PackageTags and its
	    target frameworks. The version comes from the git tag via MinVer (CSharpConventions.props).
	    Nothing here pushes: publishing is done by CI from a version tag (.github/workflows/release.yml), to nuget.org.
	-->

	<PropertyGroup>
		<Authors>Juraj Ahel</Authors>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/xeniorn/Xen.Utils.ApiKeyMinting</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/xeniorn/Xen.Utils.ApiKeyMinting</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>embedded</DebugType>
		<Deterministic>true</Deterministic>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
	</PropertyGroup>

	<!-- CI-marked build: reproducible from the tag (CI only; breaks local debugging). -->
	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

</Project>
